# /etc/pm5m.env   (chmod 600, owned by root; loaded by systemd EnvironmentFile)

# --- web login (user: admin). Use a long random value. ---
PM5M_PASSWORD=change-me-to-a-long-random-string

# --- direct HTTP on all interfaces (login is still required) ---
PM5M_HOST=0.0.0.0
PM5M_PORT=8080
PM5M_TRUST_PROXY=0            # set 1 only behind a reverse proxy that sets X-Forwarded-*
PM5M_IP_ALLOWLIST=            # optional: your own public IP(s), comma-separated, e.g. 203.0.113.7
PM5M_ALLOW_WEB_KEY=0          # keep 0: private key is never typed into the web page

# --- wallet (recommended: key via env, derived once at startup, never stored) ---
PM5M_PRIVATE_KEY=0x...
PM5M_FUNDER=0x...             # Polymarket profile address
PM5M_SIG_TYPE=2               # 0 EOA / 1 POLY_PROXY / 2 GNOSIS_SAFE / 3 DEPOSIT_WALLET

# --- storage ---
PM5M_DATA=/var/lib/pm5m
PM5M_SECRET_PASSPHRASE=       # optional: encrypt secrets.json (needed again after every restart)
